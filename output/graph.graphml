<edge source="박해철" target="2211924">
  <data key="d12">STATED_POSITION_ON</data>
  <data key="d14">설명</data>
  <data key="d15">노란봉투법은 노조법 3조를 말하는 거고요.</data>
  <data key="d16">2025-07-28</data>
  <data key="d17">N053198.md</data>
</edge>
<edge source="2200244" target="환경노동위원회">
